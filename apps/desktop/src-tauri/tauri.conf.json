{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "课知伴",
  "version": "0.4.4-beta.3",
  "identifier": "io.github.wangxingfan.coursemate",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node scripts/dev-web.mjs",
    "beforeBuildCommand": "pnpm turbo run build --filter=@deeix/web"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http: https:; media-src 'self' blob: data: http: https:; connect-src 'self' ipc: http://ipc.localhost http: https:; frame-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app",
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "课知伴学习助手",
    "longDescription": "课知伴: interactive Signals and Systems lessons, experiments, AI assistance, quizzes and spaced review.",
    "copyright": "Copyright 2026 WangXingFan. Includes DEEIX Chat code; see NOTICE and LICENSE.",
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "upgradeCode": "d0121e08-6c81-4722-a5ef-8b90fbb6f3b6",
        "language": "zh-CN"
      }
    },
    "externalBin": [
      "binaries/coursemate-server"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/WangXingFan/CourseMate/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCNTlERDdFMkI1RkNCNTMKUldSVHkxOHJmdDFacTUveSt5QjNyRDJlcmVncnVuODJJRnNsem9nMUFDUDdlUnlTMDhpMXVabVcK"
    }
  }
}
