# Copy to deploy/.env and adjust when the default host ports are occupied.
COURSEMATE_IMAGE=ghcr.io/wangxingfan/coursemate:latest

# Host ports. Container ports stay unchanged.
COURSEMATE_HOST_PORT=8081
COURSEMATE_POSTGRES_PORT=5433
COURSEMATE_REDIS_PORT=6380

# Optional extraction and OCR services.
COURSEMATE_TIKA_PORT=9999
COURSEMATE_TESSERACT_PORT=8006
COURSEMATE_DOCLING_PORT=8007
