Windows Registry Editor Version 5.00

; CourseMate enterprise policy - example. Same values as the ADMX template
; (CourseMate.admx). Import from an elevated prompt: reg import CourseMate.example.reg
; HKEY_LOCAL_MACHINE applies to every user of the computer and wins over
; HKEY_CURRENT_USER\SOFTWARE\Policies\CourseMate value by value.
; Delete a value (or the key) to return to the default. Restart CourseMate
; after a change.

[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\CourseMate]
; Server address prefilled on the setup screen: http(s) origin, no path.
"DefaultServerUrl"="https://chat.example.com"
; 1 = only DefaultServerUrl may be used (also disables local mode).
"LockServerUrl"=dword:00000001
; 1 = hide and refuse the built-in local server.
"DisableLocalMode"=dword:00000001
; 1 = never check for updates (deliver versions through your software distribution).
"DisableAutoUpdate"=dword:00000001
